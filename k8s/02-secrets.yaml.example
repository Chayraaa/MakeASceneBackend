# Values must be base64-encoded: echo -n 'myvalue' | base64
#
# IMPORTANT: SQLALCHEMY_DATABASE_URI embeds the postgres password.
# If you change POSTGRES_PASSWORD below, you MUST re-encode and update
# SQLALCHEMY_DATABASE_URI to match, or the app won't be able to connect.

apiVersion: v1
kind: Secret
metadata:
  name: makeascene-secrets
  namespace: makeascene
type: Opaque
data:
  # --- From your secrets.env — fill these in yourself, never guess real secrets ---
  # echo -n 'your-actual-value' | base64
  GOOGLE_CLIENT_ID:
  GOOGLE_CLIENT_SECRET:
  JWT_SECRET:
  RESEND_API_KEY:
  TYPESENSE_API_KEY:

  # --- Database connection string ---
  SQLALCHEMY_DATABASE_URI:

  # --- PostgreSQL credentials (used by the db StatefulSet itself) ---
  POSTGRES_USER:
  POSTGRES_PASSWORD:

  # --- S3 credentials ---
  S3_ACCESS_KEY:
  S3_SECRET_KEY: